# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.swc/

# production
/build
/deploy

# misc
.DS_Store
*.pem
.idea/
.vscode/
*.swp
*.swo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.supabase.example

# typescript
*.tsbuildinfo
next-env.d.ts

# PWA files
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/sw 2.js

*storybook.log
storybook-static
.aider*

# WeChat miniprogram
miniprogram/node_modules
miniprogram/.tea
miniprogram/miniprogram_npm
# Compiled JavaScript files (generated from TypeScript)
miniprogram/**/*.js
!miniprogram/node_modules/**/*.js
# Auto-generated config file
miniprogram/config.ts
# Shared directory compiled files (both root and miniprogram copies)
shared/**/*.js
miniprogram/shared/**/*.js
