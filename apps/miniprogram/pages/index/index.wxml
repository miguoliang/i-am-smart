<view class="container">
  <!-- Top Bar -->
  <view class="top-bar">
    <navigator url="/pages/settings/settings" class="settings-btn">
      <text>设置</text>
    </navigator>
  </view>

  <!-- Loading State -->
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <!-- Empty State -->
  <view wx:elif="{{cards.length === 0 || (cards.length > 0 && currentIndex >= cards.length)}}" class="empty">
    <text class="empty-title">今天够了，明天见 👋</text>
  </view>

  <!-- Card Flip View -->
  <view wx:else class="card-container">
    <!-- Progress Bar -->
    <view class="progress-bar-container">
      <view class="progress-bar" style="width: {{cards.length > 0 ? ((reviewedCount + currentIndex) / (reviewedCount + cards.length) * 100) : 0}}%"></view>
    </view>

    <!-- Card -->
    <view wx:if="{{cards[currentIndex]}}" class="card-wrapper" bindtap="onCardTap">
      <view class="card {{flipped ? 'flipped' : ''}}">
        <!-- Front Side -->
        <view class="card-side card-front">
          <view class="card-content">
            <text class="card-word">{{cards[currentIndex].knowledge.name}}</text>
            <view class="speech-buttons">
              <button class="speech-btn" bindtap="onSpeakUS" catchtap="true">🇺🇸</button>
              <button class="speech-btn" bindtap="onSpeakUK" catchtap="true">🇬🇧</button>
            </view>
          </view>
        </view>

        <!-- Back Side -->
        <view class="card-side card-back">
          <view class="card-content">
            <text class="card-translation">{{cards[currentIndex].knowledge.description}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Rating Buttons (only show when flipped and card exists) -->
    <view wx:if="{{flipped && cards[currentIndex]}}" class="rating-buttons">
      <button class="rating-btn rating-btn-no" bindtap="onRateNo">再看看 ✗</button>
      <button class="rating-btn rating-btn-yes" bindtap="onRateYes">会了 ✓</button>
    </view>
  </view>
</view>
