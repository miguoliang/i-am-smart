.container {
  min-height: 100vh;
  background: linear-gradient(to bottom right, #e0f2fe, #c7d2fe);
  display: flex;
  flex-direction: column;
  padding: 20rpx;
}

.top-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 40rpx;
}

.settings-btn {
  padding: 10rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.8);
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
}


.loading {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
  font-size: 32rpx;
}

.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.empty-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.empty-subtitle {
  font-size: 32rpx;
  color: #666;
}

.card-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.progress-bar-container {
  width: 100%;
  max-width: 600rpx;
  height: 8rpx;
  background-color: rgba(0, 0, 0, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-bar {
  height: 100%;
  background-color: #22c55e;
  border-radius: 4rpx;
  transition: width 0.5s ease-out;
}

.card-wrapper {
  width: 100%;
  max-width: 600rpx;
  height: 500rpx;
  perspective: 1000rpx;
}

.card {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.6s;
}

.card.flipped {
  transform: rotateY(180deg);
}

.card-side {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 20rpx;
  background-color: #fff;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.card-back {
  transform: rotateY(180deg);
}

.card-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.card-word {
  font-size: 72rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
  word-break: break-word;
}

.card-translation {
  font-size: 56rpx;
  font-weight: bold;
  color: #3cc51f;
  text-align: center;
  word-break: break-word;
}

.speech-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.speech-btn {
  padding: 15rpx 30rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
  border: none;
}

.speech-btn:active {
  background-color: #e0e0e0;
}

.card-hint {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.rating-buttons {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  width: 100%;
  max-width: 500rpx;
}

.rating-btn {
  padding: 36rpx 20rpx;
  border-radius: 20rpx;
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  border: none;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
}

.rating-btn-no {
  background-color: #f43f5e;
}

.rating-btn-yes {
  background-color: #22c55e;
}

.rating-btn:active {
  transform: scale(0.95);
}
