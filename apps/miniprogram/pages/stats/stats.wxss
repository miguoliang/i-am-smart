.container {
  min-height: 100vh;
  background: linear-gradient(to bottom right, #e0f2fe, #c7d2fe);
  padding: 40rpx 20rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  color: #666;
  font-size: 32rpx;
}

.stats-content {
  max-width: 800rpx;
  margin: 0 auto;
}

.title {
  font-size: 64rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 80rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
  margin-bottom: 60rpx;
}

.stat-item {
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  color: #fff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
}

.stat-total {
  background-color: #3b82f6;
}

.stat-mastered {
  background-color: #22c55e;
}

.stat-learning {
  background-color: #eab308;
}

.stat-due {
  background-color: #ef4444;
}

.stat-value {
  font-size: 80rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.stat-label {
  font-size: 32rpx;
}

.heatmap-section {
  background-color: #fff;
  border-radius: 40rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.heatmap-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 40rpx;
}

.heatmap-grid {
  display: grid;
  grid-template-columns: repeat(15, 1fr);
  gap: 8rpx;
}

.heatmap-cell {
  aspect-ratio: 1;
  border-radius: 8rpx;
  transition: all 0.2s;
}

.heatmap-empty {
  background-color: #e5e7eb;
}

.heatmap-low {
  background-color: #86efac;
}

.heatmap-medium {
  background-color: #4ade80;
}

.heatmap-high {
  background-color: #16a34a;
}
