.container {
  min-height: 100vh;
  background: linear-gradient(to bottom right, #e0f2fe, #c7d2fe);
  padding: 40rpx 20rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  color: #666;
  font-size: 32rpx;
}

.settings-content {
  max-width: 600rpx;
  margin: 0 auto;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 60rpx;
}

.settings-section {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
  margin-bottom: 30rpx;
}

.presets {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.preset-item {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border-radius: 10rpx;
  background-color: #f5f5f5;
  color: #333;
  font-size: 32rpx;
  font-weight: bold;
}

.preset-selected {
  background-color: #3cc51f;
  color: #fff;
}

.section-desc {
  font-size: 24rpx;
  color: #999;
}

.level-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.level-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx;
  border-radius: 10rpx;
  background-color: #f5f5f5;
  transition: all 0.2s;
}

.level-item:active {
  background-color: #e5e5e5;
}

.level-selected {
  background-color: #e0f2fe;
}

.level-pro {
  opacity: 0.8;
}

.level-coming-soon {
  opacity: 0.5;
}

.level-check {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #3cc51f;
}

.pro-icon {
  color: #f59e0b;
}

.level-name {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.level-badge {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.level-badge-pro {
  background-color: #fef3c7;
  color: #d97706;
  white-space: nowrap;
}

.level-badge-coming {
  background-color: #f3f4f6;
  color: #6b7280;
  white-space: nowrap;
}

.logout-btn {
  width: 100%;
  padding: 30rpx;
  background-color: #ef4444;
  color: #fff;
  border-radius: 10rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.logout-btn:active {
  background-color: #dc2626;
}
