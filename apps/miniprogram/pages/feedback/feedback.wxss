.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 40rpx 30rpx;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.form {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
}

.question {
  margin-bottom: 50rpx;
}

.question-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
  line-height: 1.5;
}

.required {
  color: #ff4444;
}

.option {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.option:last-child {
  border-bottom: none;
}

.option radio,
.option checkbox {
  margin-right: 20rpx;
}

.option text {
  font-size: 28rpx;
  color: #333;
}

.sub-question {
  margin-top: 30rpx;
  padding: 30rpx;
  background-color: #f9f9f9;
  border-radius: 10rpx;
}

.sub-question-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  background-color: #fff;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.error {
  display: block;
  font-size: 24rpx;
  color: #ff4444;
  margin-top: 10rpx;
}

.submit-btn {
  width: 100%;
  margin-top: 40rpx;
  background-color: #3cc51f;
  color: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-btn[disabled] {
  background-color: #ccc;
}
