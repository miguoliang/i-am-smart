<view class="container">
  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{stats}}" class="stats-content">
    <view class="title">我的学习统计</view>

    <!-- Four Grid Stats -->
    <view class="stats-grid">
      <view class="stat-item stat-total">
        <text class="stat-value">{{stats.stats.total}}</text>
        <text class="stat-label">总词量</text>
      </view>
      <view class="stat-item stat-mastered">
        <text class="stat-value">{{stats.stats.mastered}}</text>
        <text class="stat-label">已掌握</text>
      </view>
      <view class="stat-item stat-learning">
        <text class="stat-value">{{stats.stats.learning}}</text>
        <text class="stat-label">学习中</text>
      </view>
      <view class="stat-item stat-due">
        <text class="stat-value">{{stats.stats.dueToday}}</text>
        <text class="stat-label">今日待复习</text>
      </view>
    </view>

    <!-- Heatmap -->
    <view class="heatmap-section">
      <view class="heatmap-title">过去 30 天学习热力</view>
      <view class="heatmap-grid">
        <view 
          wx:for="{{stats.heatmap}}" 
          wx:key="date"
          class="heatmap-cell {{item.count === 0 ? 'heatmap-empty' : (item.count < 5 ? 'heatmap-low' : (item.count < 10 ? 'heatmap-medium' : 'heatmap-high'))}}"
        >
        </view>
      </view>
    </view>
  </view>
</view>
