.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.loading {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.review-content {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.card-display {
  background-color: #fff;
  padding: 40rpx;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.card-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.card-description {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.quality-selector {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.label {
  font-size: 28rpx;
  color: #333;
}

.picker {
  flex: 1;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 5rpx;
  text-align: center;
}

.submit-btn {
  margin-top: 40rpx;
  background-color: #3cc51f;
  color: #fff;
  border-radius: 10rpx;
  padding: 30rpx;
  font-size: 32rpx;
}

.submit-btn[disabled] {
  background-color: #ccc;
}
