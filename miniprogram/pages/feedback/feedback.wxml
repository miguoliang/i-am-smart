<view class="container">
  <view class="header">
    <text class="title">反馈问卷</text>
    <text class="subtitle">感谢你的反馈！会直接决定我们下一步加什么～</text>
  </view>

  <view class="form">
    <!-- Question 1: Occupation -->
    <view class="question">
      <text class="question-title">1. 您的职业是？（单选）<text class="required">*</text></text>
      <radio-group bindchange="onOccupationChange">
        <view class="option" wx:for="{{occupationOptions}}" wx:key="value">
          <radio value="{{item.value}}" checked="{{occupation === item.value}}" />
          <text>{{item.label}}</text>
        </view>
      </radio-group>
      <text wx:if="{{errors.occupation}}" class="error">{{errors.occupation}}</text>
    </view>

    <!-- Question 2: Learning Purpose -->
    <view class="question">
      <text class="question-title">2. 您学习英语的目的是什么？（可多选）<text class="required">*</text></text>
      <checkbox-group bindchange="onLearningPurposeChange">
        <view class="option" wx:for="{{learningPurposeOptions}}" wx:key="value">
          <checkbox value="{{item.value}}" checked="{{learningPurpose.indexOf(item.value) !== -1}}" />
          <text>{{item.label}}</text>
        </view>
      </checkbox-group>
      <text wx:if="{{errors.learningPurpose}}" class="error">{{errors.learningPurpose}}</text>
    </view>

    <!-- Question 3: Fragment Time Helpful -->
    <view class="question">
      <text class="question-title">3. 你觉得这个app对充分利用碎片时间是否有帮助？（单选）<text class="required">*</text></text>
      <radio-group bindchange="onFragmentTimeHelpfulChange">
        <view class="option">
          <radio value="yes" checked="{{fragmentTimeHelpful === 'yes'}}" />
          <text>是</text>
        </view>
        <view class="option">
          <radio value="no" checked="{{fragmentTimeHelpful === 'no'}}" />
          <text>否</text>
        </view>
      </radio-group>
      <text wx:if="{{errors.fragmentTimeHelpful}}" class="error">{{errors.fragmentTimeHelpful}}</text>
      
      <view wx:if="{{fragmentTimeHelpful === 'no'}}" class="sub-question">
        <text class="sub-question-title">请说明为什么觉得没有帮助：<text class="required">*</text></text>
        <textarea
          placeholder="请告诉我们为什么觉得没有帮助..."
          value="{{fragmentTimeNotHelpfulReason}}"
          bindinput="onFragmentTimeNotHelpfulReasonInput"
          maxlength="1000"
          class="textarea"
        />
        <text class="char-count">{{fragmentTimeNotHelpfulReason.length}}/1000</text>
        <text wx:if="{{errors.fragmentTimeNotHelpfulReason}}" class="error">{{errors.fragmentTimeNotHelpfulReason}}</text>
      </view>
    </view>

    <!-- Question 4: Will Recommend -->
    <view class="question">
      <text class="question-title">4. 您会把这个App推荐给朋友吗？<text class="required">*</text></text>
      <radio-group bindchange="onWillRecommendChange">
        <view class="option">
          <radio value="yes" checked="{{willRecommend === 'yes'}}" />
          <text>会</text>
        </view>
        <view class="option">
          <radio value="no" checked="{{willRecommend === 'no'}}" />
          <text>不会</text>
        </view>
      </radio-group>
      <text wx:if="{{errors.willRecommend}}" class="error">{{errors.willRecommend}}</text>
      
      <view wx:if="{{willRecommend === 'no'}}" class="sub-question">
        <text class="sub-question-title">请说明不推荐的原因：<text class="required">*</text></text>
        <textarea
          placeholder="请告诉我们为什么不推荐..."
          value="{{notRecommendReason}}"
          bindinput="onNotRecommendReasonInput"
          maxlength="1000"
          class="textarea"
        />
        <text class="char-count">{{notRecommendReason.length}}/1000</text>
        <text wx:if="{{errors.notRecommendReason}}" class="error">{{errors.notRecommendReason}}</text>
      </view>
    </view>

    <!-- Question 5: Open Feedback -->
    <view class="question">
      <text class="question-title">5. 改进建议（可选）</text>
      <textarea
        placeholder="请分享你的改进建议..."
        value="{{openFeedback}}"
        bindinput="onOpenFeedbackInput"
        maxlength="2000"
        class="textarea"
      />
      <text class="char-count">{{openFeedback.length}}/2000</text>
    </view>

    <button class="submit-btn" bindtap="onSubmit" disabled="{{loading}}">
      {{loading ? '提交中...' : '提交反馈'}}
    </button>
  </view>
</view>
