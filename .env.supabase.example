# 生产/部署用环境变量，与 GitHub Actions 部署时使用的 Secrets 对应
# 复制为 .env.supabase 并填入真实值；不要提交 .env.supabase
# 部署时在仓库 Settings → Secrets 中逐项添加同名 Secret，workflow 会生成此文件

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_BAIDU_ANALYTICS_ID=
NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=
NEXT_PUBLIC_SITE_URL=

# 微信开放平台 - 网站应用（可选，不配置则不显示微信登录按钮）
# WECHAT_OPEN_APP_ID=           # 服务端 + 前端需 NEXT_PUBLIC_ 同值
# WECHAT_OPEN_APP_SECRET=       # 仅服务端，勿提交
# NEXT_PUBLIC_WECHAT_OPEN_APP_ID=  # 前端拼授权 URL 用
# NEXT_PUBLIC_APP_ORIGIN=       # 回调与 Magic Link 重定向用，须与微信授权回调域一致，如 https://www.iamsmart.top

# Apple 登录（可选，不配置则不显示 Apple 登录按钮）
# 使用 Supabase signInWithOAuth 重定向流，浏览器经 Supabase 跳转至 Apple 授权页；
# 无需在 Apple Developer Console 注册/验证托管域名。
# 1. 在 Apple Developer Console 创建 Services ID，启用 "Sign In with Apple"
#    Return URL 须填 Supabase 回调地址：https://<project>.supabase.co/auth/v1/callback
# 2. 生成私钥并构建 Apple client secret（JWT）
# 3. 在 Supabase Dashboard → Auth → Providers → Apple 配置 client_id 和 secret
# 4. 在 Supabase Dashboard → Auth → URL Configuration → Redirect URLs 添加【所有】应用域名
#    ⚠️ 每个可能发起登录的域名都必须加入，否则 Supabase 会静默回退到 site_url（生产域名），
#    导致用户在其他域名（如 preview）登录后被错误地重定向到生产域名。
#    示例：
#      - https://www.iamsmart.top/**
#      - https://preview.iamsmart.top/**
# 5. 设置以下环境变量即可在前端显示 Apple 登录按钮
# NEXT_PUBLIC_APPLE_CLIENT_ID=  # Apple Services ID（如 top.iamsmart.pwa）

# 微信支付 - Native 支付（可选，不配置则 /pay 创建订单会报错）
# WECHAT_PAY_MCH_ID=            # 商户号
# WECHAT_PAY_APP_ID=            # 与商户号绑定的 AppID
# WECHAT_PAY_MERCHANT_SERIAL_NO= # 商户 API 证书序列号
# WECHAT_PAY_PRIVATE_KEY=       # 商户私钥 PEM 全文
# WECHAT_PAY_API_V3_KEY=        # APIv3 密钥（32 字节）

# 支付宝支付 - PC网站支付 & 手机网站支付（可选）
# 在支付宝开放平台创建网页/移动应用，获取以下配置
# ALIPAY_APP_ID=                # 应用 APPID
# ALIPAY_PRIVATE_KEY=           # 应用私钥（RSA2，PEM 格式，可用 \n 表示换行）
# ALIPAY_PUBLIC_KEY=            # 支付宝公钥（非应用公钥，从开放平台获取，PEM 格式）

# 微信小程序登录（必需，小程序功能需要）
# WECHAT_MINIPROGRAM_APP_ID=     # 小程序 AppID（从微信公众平台获取）
# WECHAT_MINIPROGRAM_APP_SECRET= # 小程序 AppSecret（敏感，仅服务端，勿提交）

# 阿里云 SMS（手机验证码登录，通过 Supabase send_sms Hook 调用）
# 在 Supabase Dashboard > Edge Functions > Secrets 中配置以下变量：
# ALIYUN_SMS_ACCESS_KEY_ID=       # 阿里云 AccessKey ID
# ALIYUN_SMS_ACCESS_KEY_SECRET=   # 阿里云 AccessKey Secret（敏感，勿提交）
# ALIYUN_SMS_SIGN_NAME=           # 短信签名名称，如 "我的应用"
# ALIYUN_SMS_TEMPLATE_CODE=       # 短信模板CODE，如 "SMS_123456"
#                                 # 模板内容示例："您的验证码是${code}，5分钟内有效。"
# SUPABASE_AUTH_HOOK_SECRET=      # Auth Hook 签名验证密钥（可选，增强安全性）
